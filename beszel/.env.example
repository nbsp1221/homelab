# ── Optional legacy Hub (--profile legacy) ───────────────────
# Public URL used in notification links and agent config generation.
# Set this to your actual domain behind the reverse proxy.
BESZEL_APP_URL=https://beszel.example.com

# Optional: to create the first admin user automatically on first start,
# add these to the beszel service's environment block in compose.yaml:
#
#   USER_EMAIL: admin@example.com
#   USER_PASSWORD: changeme
#
# If omitted, you will be prompted to create an account in the web UI.

# ── Beszel Agent ────────────────────────────────────────────
# Register this host through Add System in the target Hub.
# Copy that Hub's public key and this system's individual token.
# Keep the populated .env private; do not use a Universal Token.
BESZEL_HUB_URL=https://beszel.example.com
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=
