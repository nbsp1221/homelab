# Host-local secret. Restrict the token to the relevant Cloudflare zone with
# Zone:Read and DNS:Edit permissions. Keep the populated .env outside Git.
CLOUDFLARE_API_TOKEN=replace-with-a-scoped-cloudflare-api-token

# Replace these example values with the domain and the host's Tailscale IPs.
CADDY_DOMAIN=beszel.example.com
CADDY_BIND_IPV4=192.0.2.10
CADDY_BIND_IPV6=2001:db8::10
