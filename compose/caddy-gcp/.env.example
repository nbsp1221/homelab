# Host-local secret. Restrict this token to the retn0.dev zone with
# Zone:Read and DNS:Edit permissions. Never commit the populated .env.
CLOUDFLARE_API_TOKEN=replace-with-a-scoped-cloudflare-api-token

# Non-secret values are supplied by hosts/retn0-srv-gcp-01/host.yaml.
CADDY_DOMAIN=beszel.example.com
CADDY_BIND_IPV4=100.64.0.10
CADDY_BIND_IPV6=fd7a:115c:a1e0::10
