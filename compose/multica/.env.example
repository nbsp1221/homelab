# Official images and stable release channel
MULTICA_IMAGE_TAG=v0.6.0

# PostgreSQL
POSTGRES_DB=multica
POSTGRES_USER=multica
POSTGRES_PASSWORD=replace-with-a-random-password

# Server security and public URLs. Replace FRONTEND_ORIGIN with the URL users
# actually visit when placing the stack behind a reverse proxy.
APP_ENV=production
# Disable anonymous self-host telemetry.
DO_NOT_TRACK=true
JWT_SECRET=replace-with-a-random-secret
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=
MULTICA_APP_URL=${FRONTEND_ORIGIN}
MULTICA_PUBLIC_URL=

# Same-origin browser layout: keep cookies host-only and browser API/WS URLs relative.
COOKIE_DOMAIN=
REMOTE_API_URL=http://backend:8080
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Signup is closed by default for a public deployment.
# For the first account, set ALLOWED_EMAILS to the operator email address.
ALLOW_SIGNUP=false
DISABLE_WORKSPACE_CREATION=false
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# Keep deterministic verification disabled in production.
MULTICA_DEV_VERIFICATION_CODE=

# Self-hosted VCS token encryption. Generate with: openssl rand -base64 32
MULTICA_VCS_INTEGRATION_ENABLED=true
MULTICA_VCS_SECRET_KEY=replace-with-a-random-base64-key

# Optional integrations remain disabled until explicitly configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@multica.ai
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=
SMTP_TLS_INSECURE=false
SMTP_EHLO_NAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${FRONTEND_ORIGIN}/auth/callback
S3_BUCKET=
S3_REGION=us-west-2
AWS_ENDPOINT_URL=
S3_USE_PATH_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ATTACHMENT_DOWNLOAD_MODE=auto
ATTACHMENT_DOWNLOAD_URL_TTL=30m
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
MULTICA_LARK_SECRET_KEY=
MULTICA_LARK_HTTP_BASE_URL=
MULTICA_LARK_CALLBACK_BASE_URL=
MULTICA_SLACK_SECRET_KEY=
MULTICA_WECOM_SECRET_KEY=
METRICS_ADDR=
MULTICA_TRUSTED_PROXIES=
