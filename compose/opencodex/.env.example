# OpenCodex package version installed when the image is built.
OPENCODEX_VERSION=2.19.0

# Client token (/v1) and separate admin token (/api).
# Generate each independently with: openssl rand -hex 32
OPENCODEX_API_AUTH_TOKEN=
OPENCODEX_ADMIN_AUTH_TOKEN=

# Host directory containing the active Codex auth.json; mounted read-only.
CODEX_HOST_HOME=/home/you/.codex
