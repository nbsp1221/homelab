# Rebuild the image after changing this version.
OPENCODEX_VERSION=2.10.1

# Admission token for remote Codex clients (/v1/*).
# Generate with: openssl rand -hex 32
OPENCODEX_API_AUTH_TOKEN=

# Dashboard and management API token (/api/*).
# It must differ from OPENCODEX_API_AUTH_TOKEN.
# Generate with: openssl rand -hex 32
OPENCODEX_ADMIN_AUTH_TOKEN=

# Host Codex home. OpenCodex reads its OAuth login as the pool's main account.
CODEX_HOST_HOME=/home/you/.codex
