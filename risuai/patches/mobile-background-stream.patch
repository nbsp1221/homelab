+        frozen = false;
+        if (detachedForBackground) {
+            scheduleConnect();
+        }
+    };
+
+    const visibilityHandler = () => {
+        if (settled) {
+            return;
+        }
+        if (document.visibilityState === 'hidden') {
+            detachedForBackground = true;
+            closeSocket();
+            return;
+        }
