+
+    function cloneWithoutSwipeState(message: Message): Message {
+        const cloned = safeStructuredClone(message)
+        delete cloned.swipes
+        delete cloned.swipeId
+        return cloned
+    }
+
+    function cleanSwipeVariant(messages: Message[]) {
+        return messages.map(cloneWithoutSwipeState)
+    }
+
+    function attachSwipeState(messages: Message[], swipes: Message[][], swipeId: number) {
+        const nextMessages = cleanSwipeVariant(messages)
+        const lastMessage = nextMessages.at(-1)
+        if(lastMessage){
+            lastMessage.swipes = swipes.map(cleanSwipeVariant)
+            lastMessage.swipeId = swipeId
+        }
+        return nextMessages
+    }
+
+    function getActiveSwipeState(messages: Message[]) {
+        const lastMessage = messages.at(-1)
+        if(!lastMessage || !Array.isArray(lastMessage.swipes) || lastMessage.swipes.length === 0){
+            return null
+        }
+        const swipes = lastMessage.swipes.map(cleanSwipeVariant)
+        const swipeId = Math.min(Math.max(lastMessage.swipeId ?? swipes.length - 1, 0), swipes.length - 1)
+        const activeLength = Math.max(swipes[swipeId]?.length ?? 1, 1)
+        return { swipes, swipeId, activeLength }
+    }
+
+    function getCurrentResponseVariant(messages: Message[]) {
+        const variant: Message[] = []
+        const saying = messages.at(-1)?.saying
+        let sayingQu = 2
+        for(let i = messages.length - 1; i >= 0; i--){
+            const message = messages[i]
+            if(message.role === 'user'){
+                break
+            }
+            if(message.saying === saying){
+                sayingQu -= 1
+                if(sayingQu === 0){
+                    break
+                }
+            }
+            variant.unshift(cloneWithoutSwipeState(message))
+        }
+        return variant
+    }
+
+    function replaceSwipeVariant(swipeId: number) {
+        const messages = getCurrentMessages()
+        const swipeState = getActiveSwipeState(messages)
+        if(!swipeState){
