+        const targetVariant = swipeState.swipes[swipeId]
+        if(!targetVariant){
+            return
+        }
+        const baseMessages = messages.slice(0, messages.length - swipeState.activeLength)
+        setCurrentMessages([
+            ...baseMessages,
+            ...attachSwipeState(targetVariant, swipeState.swipes, swipeId)
+        ])
+    }
