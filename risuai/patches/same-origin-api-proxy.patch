+])
+
+const normalizePluginFetchUrl = (url: string) => {
+    try {
+        const parsed = new URL(url, window.location.href)
+        const isApiProxyPath = parsed.pathname === '/api-proxy' || parsed.pathname.startsWith('/api-proxy/')
+        if(sameOriginApiProxyHosts.has(parsed.hostname) && isApiProxyPath){
+            return new URL(
+                `${parsed.pathname}${parsed.search}${parsed.hash}`,
+                window.location.origin
+            ).href
+        }
+    } catch {
+        // Preserve the existing fetch error for malformed URLs.
+    }
+    return url
+}
