BESZEL_HUB_URL=https://beszel.example.com
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN_PATH=/path/to/beszel-agent-nvidia.token
BESZEL_FILESYSTEM=example-root-device
BESZEL_SENSORS=
BESZEL_SMART_DEVICES=/dev/nvme9:nvme,/dev/sdz:sat
BESZEL_SERVICE_PATTERNS=
BESZEL_EXTRA_FILESYSTEM_PATH=/path/to/extra-filesystem/.beszel
BESZEL_NVME_DEVICE=/dev/nvme9
BESZEL_SECONDARY_DEVICE=/dev/sdz
